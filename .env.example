# Copy to .env and adjust per environment. Values shown are the production
# defaults; docker compose interpolates these into the containers.

# ---- Backend (Go Agent Network) ----
BACKEND_HTTP_ADDR=:8080
BACKEND_ZONE_TOPOLOGY=CONCOURSE_A,BAG_CHECK,E_PIER,GATE_A,GATE_B,PLATFORM_1,PLATFORM_2,SECURITY_T1,SECURITY_T2

# ---- AI Telemetry (Python / FastAPI) ----
AI_HTTP_ADDR=0.0.0.0:8000
AI_SIM_LOOP_INTERVAL_SECONDS=2
AI_EMIT_TO_BACKEND=http://backend:8080/api/v1/telemetry
AI_HF_MODEL_ID=yolo11n
# Production default: live detection. The YOLO checkpoint and sample frames
# are baked into the image, so cold starts never download. Without local
# weights or network access the seam degrades to SIMULATED automatically.
AI_MODE=live
HF_TOKEN=
# Optional overrides; the baked-in app paths are the defaults.
# AI_FRAMES_DIR=/srv/data/frames
# AI_WEIGHTS_DIR=/srv/data/weights

# ---- Frontend (Next.js) ----
# Inlined into the client bundle at build time; must match the host port the
# backend is published on.
NEXT_PUBLIC_API_URL=http://localhost:8080
